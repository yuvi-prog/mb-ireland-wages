# ── Square API ────────────────────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=your_square_access_token_here

# Square Location IDs for each Irish store
# Find these in Square Dashboard → Locations, or via GET /v2/locations
SQUARE_LOC_BLANCHARDSTOWN=your_location_id
SQUARE_LOC_CORK=your_location_id
SQUARE_LOC_LIFFEY_VALLEY=your_location_id
SQUARE_LOC_NUTGROVE=your_location_id
SQUARE_LOC_WHITEWATER=your_location_id

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_TO=yuvi@memoryblock.com.au
EMAIL_FROM=wages@memoryblock.com.au   # must be verified in SendGrid

# ── App ───────────────────────────────────────────────────────────────────────
API_KEY=choose_a_strong_secret_key_here
DATA_DIR=/data   # Railway volume mount point (leave as-is)
